{
  "extends": ["@avi2dg/checks/tsconfig.effect.json"],
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": [
              "**/*.ts",
              "**/*.tsx",
              "**/*.mts",
              "**/*.cts"
            ],
            "exclude": [
              "tests/**",
              "**/*.test.ts",
              "**/*.test.tsx",
              "evals/**",
              "harness/**",
              "src/dispatcher/claude-dispatcher.ts",
              "src/dispatcher/codex-dispatcher.ts",
              "src/dispatcher/commit-identity.ts",
              "src/dispatcher/credential-reads.ts",
              "src/dispatcher/dispatch-log.ts",
              "src/dispatcher/dispatch.ts",
              "src/dispatcher/forbid.ts",
              "src/dispatcher/gate.ts",
              "src/dispatcher/gate-config.ts",
              "src/dispatcher/glob.ts",
              "src/dispatcher/hook-bash.ts",
              "src/dispatcher/hook-harness.ts",
              "src/dispatcher/job-queue.ts",
              "src/dispatcher/model-scope.ts",
              "src/dispatcher/pi-bash.ts",
              "src/dispatcher/pi-dispatcher.ts",
              "src/dispatcher/pi-redact.ts",
              "src/dispatcher/project.ts",
              "src/dispatcher/read-index.ts",
              "src/dispatcher/redact.ts",
              "src/dispatcher/rerun.ts",
              "src/dispatcher/repo-walk.ts",
              "src/dispatcher/run-state.ts",
              "src/dispatcher/shell-words.ts",
              "src/dispatcher/tool-call-fired.ts",
              "src/dispatcher/transcript.ts",
              "src/dispatcher/types.ts",
              "src/dispatcher/verdict.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "error",
                "asyncFunction": "error",
                "newPromise": "error",
                "extendsNativeError": "error",
                "processEnv": "error",
                "processEnvInEffect": "error"
              }
            }
          }
        ],
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "missingEffectError": "error",
          "unknownInEffectCatch": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "catchUnfailableEffect": "error",
          "catchAllToMapError": "error",
          "missingReturnYieldStar": "error",
          "floatingEffect": "error",
          "outdatedApi": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "harness/**/*.ts",
    "evals/**/*.ts",
    "scripts/**/*.ts",
    "oxlint.config.ts",
    "knip.config.ts",
    "dependency-cruiser.config.ts"
  ]
}
