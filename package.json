{
  "name": "skills",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "author": "avi2d <avi2dg@gmail.com>",
  "repository": "https://github.com/avi2d/skills",
  "type": "module",
  "scripts": {
    "generate": "bun run src/generate/generate.ts",
    "build": "checks-effect-scope && checks-changelog",
    "test": "checks-test",
    "test:local": "bun scripts/test-local.ts",
    "test:fast": "bun scripts/test-fast.ts",
    "lint": "oxlint && checks-lint",
    "typecheck": "tsc --noEmit && effect-tsgo diagnostics --project tsconfig.json --format text --strict",
    "link": "bun run src/generate/link.ts",
    "docs": "bun run src/docs/docs.ts",
    "prepare": "checks-vendor --library effect --package effect --repository https://github.com/Effect-TS/effect.git --tag 'effect@{version}' --path packages/effect/package.json",
    "dispatch-report": "bun run src/report/dispatch-report.ts",
    "context-index": "bun run src/context/context-index.ts",
    "context-report": "bun run src/context/context-report.ts",
    "eval": "vitest run --config evals/vitest.config.ts --configLoader runner",
    "mutate": "scripts/clean-tree.sh && stryker run",
    "mutate:incremental": "bun run mutate --incremental"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@effect/tsgo": "0.45.0",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@stryker-mutator/core": "10.0.0",
    "@swc/core": "1.16.2",
    "@types/bun": "^1.3.0",
    "dependency-cruiser": "18.4.0",
    "jscpd": "5.3.2",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "vitest-evals": "0.17.0"
  },
  "dependencies": {
    "@avi2dg/checks": "^0.57.0",
    "@effect/platform-bun": "4.0.0",
    "effect": "4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "typebox": "1.3.27"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0",
    "@vitest/mocker": "4.1.12",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "qs": "6.16.0",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "undici": "8.12.3",
    "vite": "8.3.5",
    "zod": "4.6.7"
  }
}
