{
  "array_order": "preference",
  "rules": [
    {
      "when": "Trivial or mechanical work whose outcome is fully specified: a rote rename, formatting sweep, typo fix, config or selection flip, deleting or moving named files and sections, removing leftovers a tool generated, or gathering files; multi-file is fine as long as no design choice is left to make.",
      "use": [
        {
          "harness": "pi",
          "model": "opencode-go/muse-spark-1.3-contributor",
          "effort": "low",
          "provider": "opencode-go"
        },
        {
          "harness": "pi",
          "model": "claude-bridge/claude-haiku-5-5",
          "effort": "low",
          "provider": "claude",
          "floor": {
            "scope": "all_models",
            "min_percent": 15
          }
        },
        {
          "harness": "pi",
          "model": "claude-bridge/claude-opus-5-5",
          "effort": "low",
          "provider": "claude"
        }
      ]
    },
    {
      "when": "Well-scoped small implementation work expected to change about 150 lines or fewer: a clearly specified feature, an ordinary bug fix with a clear pointer to the cause, writing tests for existing behavior, or a routine refactor following an existing pattern.",
      "use": [
        {
          "harness": "pi",
          "model": "opencode-go/muse-spark-1.3-contributor",
          "effort": "high",
          "provider": "opencode-go"
        },
        {
          "harness": "pi",
          "model": "claude-bridge/claude-haiku-5-5",
          "effort": "high",
          "provider": "claude",
          "floor": {
            "scope": "all_models",
            "min_percent": 15
          }
        },
        {
          "harness": "pi",
          "model": "claude-bridge/claude-opus-5-5",
          "effort": "medium",
          "provider": "claude"
        }
      ]
    },
    {
      "when": "Work that can only be done on this Mac: its own configuration, terminal, herdr, WezTerm, pi setup or home network.",
      "use": [
        {
          "harness": "pi",
          "model": "claude-bridge/claude-opus-5-5",
          "effort": "high",
          "provider": "claude"
        }
      ]
    },
    {
      "when": "Ambiguous or cross-system investigation, audit, diagnosis, or planning that spans systems or leaves the scope open.",
      "use": [
        {
          "harness": "pi",
          "model": "claude-bridge/claude-opus-5-5",
          "effort": "high",
          "provider": "claude"
        }
      ]
    }
  ],
  "default": [
    {
      "harness": "pi",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "effort": "high",
      "provider": "opencode-go"
    },
    {
      "harness": "pi",
      "model": "claude-bridge/claude-opus-5-5",
      "effort": "medium",
      "provider": "claude"
    }
  ]
}
