{
  "description": "Codex's Contract: the Dispatcher, plus the session probes that were already here. UserPromptSubmit sends Rules whole rather than as a preview (docs/adr/0022).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.codex/skills-dispatch/index.ts\" SessionStart",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.codex/skills-dispatch/index.ts\" UserPromptSubmit",
            "timeout": 30,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.codex/skills-dispatch/index.ts\" PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.codex/skills-dispatch/index.ts\" PreCompact",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.codex/skills-dispatch/index.ts\" Stop",
            "timeout": 150
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.codex/skills-dispatch/index.ts\" SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
