  "retry": {
    "provider": {
      "maxRetries": 12,
      "maxRetryDelayMs": 180000
    }
  },
  "showCacheMissNotices": true,
  "cacheWarming": "off",
  "terminal": {
    "showTerminalProgress": false
  },
  "warnings": {
    "anthropicExtraUsage": false
  }
}
